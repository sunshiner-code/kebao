# 复制为 .env 后按需填写。全部留空也能运行：系统会使用内置推理引擎与本地 SQLite。
# .env 已被 .gitignore 忽略，请勿提交真实密钥。

# ---------------------------------------------------------------------------
# 云端大模型（OpenAI 兼容接口）：规划、综合推理、长文本、评审与反思；只接收脱敏后的数据
# ---------------------------------------------------------------------------
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=deepseek-chat
# 模型卡片上展示的名称，不填则展示 CLOUD_LLM_MODEL
CLOUD_LLM_DISPLAY_MODEL=
CLOUD_LLM_EXTRA={}

# ---------------------------------------------------------------------------
# 私有化部署模型（文本与多模态共用）：私有材料、图像与高敏数据
# 生产环境应指向本地/专有部署；凡带图片的交互按 L3 处理，不得出域到云端
# ---------------------------------------------------------------------------
PRIVATE_LLM_BASE_URL=
PRIVATE_LLM_API_KEY=
PRIVATE_LLM_MODEL=
PRIVATE_LLM_DISPLAY_MODEL=
PRIVATE_LLM_EXTRA={"thinking": {"type": "disabled"}}

# ---------------------------------------------------------------------------
# 运行开关
# ---------------------------------------------------------------------------
# 置为 1 时关闭大模型，全部推理任务由内置推理引擎完成
TECHINS_DISABLE_LLM=0
# 风险预警单独开关。仅当本项与 TECHINS_DISABLE_LLM 同时为 0 时，风险预警才调用大模型
TECHINS_DISABLE_RW_LLM=0
# 登录页是否展示演示账号。1 展示角色快捷入口，0 只保留账号密码登录
TECHINS_SHOW_DEMO_ACCOUNTS=0
# 置为 1 时，启动时在后台自动创建演示数据集
TECHINS_DEMO_BOOTSTRAP=0

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
# 运行数据目录，默认 <项目根>/data
# TECHINS_DATA_DIR=
# 数据库连接串。留空时使用 data/techins.db（SQLite）；填写后优先使用该连接串
# TECHINS_DATABASE_URL=mysql+pymysql://techins:password@127.0.0.1:3306/techins?charset=utf8mb4

# 业务库：由 docker compose up -d 启动本地 MySQL。填写 MYSQL_PASSWORD 后应用自动连接 MySQL
# MYSQL_USER=techins
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=techins
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# 安全
# ---------------------------------------------------------------------------
# JWT 签名密钥。生产环境必须设置为足够长的随机字符串
TECHINS_JWT_SECRET=
# 允许的跨域来源，逗号分隔。默认 *（仅建议本地开发使用）
TECHINS_CORS_ORIGINS=*
# 前端 dev server 允许的额外来源（例如局域网 IP），逗号分隔
# TECHINS_DEV_ORIGINS=192.168.1.10
# 连接器凭据加密密钥；留空时会在数据目录生成密钥文件
TECHINS_CONNECTOR_KEY=
TECHINS_JWT_TTL_HOURS=12

# ---------------------------------------------------------------------------
# 常驻监测：每隔多少秒推进一次仿真时钟、每次推进的仿真分钟数
# ---------------------------------------------------------------------------
TECHINS_MONITOR_TICK_SECONDS=60
TECHINS_SIM_MINUTES_PER_TICK=60
